rules_version = '2';

// Reglas de seguridad de Firestore para RestauranteSmart.
// La interfaz (guards de Angular) solo oculta pantallas; quien decide de verdad
// qué puede leer o escribir cada usuario son estas reglas.
service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function rutaPerfil() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }

    // Empleado = cuenta de Auth con perfil en usuarios/{uid}.
    // Borrar el perfil revoca el acceso aunque la cuenta siga existiendo.
    function esEmpleado() {
      return autenticado() && exists(rutaPerfil());
    }

    function esGerente() {
      return esEmpleado()
        && get(rutaPerfil()).data.rol.lower() in ['gerente', 'admin', 'administrador', 'jefe'];
    }

    // Permisos especiales del perfil (cobrarMesas, verVentas, verInventario).
    // Gerencia los tiene todos. Mismo criterio que AuthService.tienePermiso().
    function permiso(nombre) {
      return esGerente()
        || (esEmpleado() && get(rutaPerfil()).data.get('permisos', {}).get(nombre, false) == true);
    }

    // Cobrar es pasar la comanda a uno de estos estados (o tocarla cuando ya está en ellos).
    function esEstadoDeCobro(datos) {
      return datos.get('estado', '') in ['Aprobada_Para_Pago', 'Pagada'];
    }

    function reservaValida(r) {
      return r.keys().hasOnly(['nombre', 'telefono', 'fecha', 'hora', 'personas', 'estado', 'fechaCreacion'])
        && r.nombre is string && r.nombre.size() > 0 && r.nombre.size() <= 80
        && r.telefono is string && r.telefono.size() <= 20
        && r.fecha is string && r.fecha.size() > 0 && r.fecha.size() <= 20
        && r.hora is string && r.hora.size() > 0 && r.hora.size() <= 10
        && r.personas is number && r.personas >= 1 && r.personas <= 30
        && r.estado == 'Pendiente'
        && r.fechaCreacion is timestamp;
    }

    // Carta: pública para clientes; solo gerencia la modifica.
    match /platos/{id} {
      allow read: if true;
      allow write: if esGerente();
    }

    // Reservas: cualquier cliente puede crear una (validada); solo el personal las ve y gestiona.
    match /reservas/{id} {
      allow create: if reservaValida(request.resource.data);
      allow read, update, delete: if esEmpleado();
    }

    // Comandas: sala y cocina. Cobrar exige el permiso cobrarMesas; borrar, gerencia.
    match /comandas/{id} {
      allow read: if esEmpleado();
      allow create: if esEmpleado() && !esEstadoDeCobro(request.resource.data);
      allow update: if esEmpleado()
        && ((!esEstadoDeCobro(resource.data) && !esEstadoDeCobro(request.resource.data))
            || permiso('cobrarMesas'));
      allow delete: if esGerente();
    }

    // Inventario: gerencia o empleados con verInventario.
    match /inventario/{id} {
      allow read, write: if permiso('verInventario');
    }

    // Caja: verVentas es de consulta; los movimientos los registra gerencia.
    // Excepción: quien gestiona el inventario apunta el gasto de reponer stock.
    match /operaciones_caja/{id} {
      allow read: if permiso('verVentas');
      allow write: if esGerente();
      allow create: if permiso('verInventario')
        && request.resource.data.tipo == 'Gasto'
        && request.resource.data.concepto is string
        && request.resource.data.concepto.matches('Reposición almacén: .*');
    }

    // Perfiles: cada empleado lee el suyo; solo gerencia los crea, edita o borra.
    // Un empleado no puede cambiarse su propio rol.
    match /usuarios/{uid} {
      allow read: if autenticado() && (request.auth.uid == uid || esGerente());
      allow write: if esGerente();
    }

    // Todo lo demás, denegado.
  }
}
